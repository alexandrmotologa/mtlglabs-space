{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "mcp.mtlglabs.space"
        }
      ],
      "destination": "/mcp/index.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "mcp.mtlglabs.space"
        }
      ],
      "destination": "/mcp/$1"
    }
  ]
}
